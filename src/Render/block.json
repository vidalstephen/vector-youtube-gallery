{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "vectoryt/gallery",
    "version": "0.1.0",
    "title": "YouTube Gallery",
    "category": "embed",
    "icon": "video-alt3",
    "description": "Render a YouTube source feed from the Vector YouTube Gallery plugin.",
    "keywords": ["youtube", "gallery", "shorts", "live", "video"],
    "textdomain": "vector-youtube-gallery",
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "attributes": {
        "feed_uuid": {
            "type": "string",
            "default": ""
        },
        "source_uuid": {
            "type": "string",
            "default": ""
        },
        "layout": {
            "type": "string",
            "default": "grid"
        },
        "per_page": {
            "type": "number",
            "default": 12
        },
        "columns": {
            "type": "number",
            "default": 3
        },
        "orderby": {
            "type": "string",
            "default": "published_at"
        },
        "order": {
            "type": "string",
            "default": "DESC"
        },
        "content_type": {
            "type": "string",
            "default": ""
        },
        "pagination": {
            "type": "string",
            "default": "none"
        },
        "schema_enabled": {
            "type": "boolean",
            "default": false
        },
        "preset": {
            "type": "string",
            "default": "default"
        },
        "width": {
            "type": "string",
            "default": "wide"
        },
        "see_all_url": {
            "type": "string",
            "default": ""
        },
        "see_all_label": {
            "type": "string",
            "default": ""
        },
        "show_kicker": {
            "type": "boolean",
            "default": true
        },
        "show_h1": {
            "type": "boolean",
            "default": true
        },
        "show_intro": {
            "type": "boolean",
            "default": false
        },
        "show_pill": {
            "type": "boolean",
            "default": false
        },
        "show_channel_cta": {
            "type": "boolean",
            "default": false
        },
        "show_feed_header": {
            "type": "boolean",
            "default": false
        },
        "feed_kicker": {
            "type": "string",
            "default": ""
        },
        "feed_title": {
            "type": "string",
            "default": ""
        },
        "feed_intro": {
            "type": "string",
            "default": ""
        },
        "feed_cta_label": {
            "type": "string",
            "default": ""
        },
        "feed_cta_url": {
            "type": "string",
            "default": ""
        },
        "header_kicker": {
            "type": "string",
            "default": ""
        },
        "header_intro": {
            "type": "string",
            "default": ""
        },
        "density": {
            "type": "string",
            "default": "comfortable"
        },
        "header_title": {
            "type": "string",
            "default": ""
        },
        "header_subtitle": {
            "type": "string",
            "default": ""
        },
        "header_columns_visible": {
            "type": "boolean",
            "default": true
        },
        "header_cta_label": {
            "type": "string",
            "default": ""
        },
        "header_cta_url": {
            "type": "string",
            "default": ""
        },
        "show_channel_avatar": {
            "type": "boolean",
            "default": true
        },
        "show_channel_name": {
            "type": "boolean",
            "default": true
        },
        "show_subscriber_count": {
            "type": "boolean",
            "default": false
        },
        "show_verified_badge": {
            "type": "boolean",
            "default": false
        },
        "show_views_and_time": {
            "type": "boolean",
            "default": true
        },
        "product_cta_visible": {
            "type": "boolean",
            "default": true
        },
        "trust_strip": {
            "type": "boolean",
            "default": false
        },
        "card_radius": {
            "type": "string",
            "default": "12px"
        },
        "thumbnail_fit": {
            "type": "string",
            "default": "cover"
        },
        "thumbnail_position": {
            "type": "string",
            "default": "center_center"
        },
        "thumbnail_override_url": {
            "type": "string",
            "default": ""
        }
    },
    "editorScript": "vyg-editor",
    "render": "file:./render.php"
}
