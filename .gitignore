# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp
*~
*.bak

# --- Secrets (NEVER commit) ---
.env
.env.local
*.env.local
dev/.env
dev/secrets/

# --- PHP / Composer ---
vendor/
.phpunit.result.cache
.phpunit.cache/

# Keep composer.lock tracked (locks dev dep versions for reproducible builds)

# --- Node / Build ---
node_modules/
assets/dist/*.map
assets/src/**/*.{js,css}
!assets/src/**/index.js
!assets/src/**/index.scss

# --- WordPress dev volumes ---
dev/wordpress/
dev/db/
dev/wp-content/
dev/uploads/
dev/logs/

# --- Test artifacts ---
tests/coverage/
tests/.cache/
playwright-report/
test-results/

# --- Logs ---
*.log
dev/logs/*.log

# --- OS / Tooling caches ---
.cache/
.mypy_cache/
.pytest_cache/screenshots/

# --- Phase 14 visual capture artifacts ---
# Keep final contact sheets; do not commit bulky per-layout/diff PNGs.
screenshots/prototype-parity/*.png
!screenshots/prototype-parity/contact-sheet-desktop.png
!screenshots/prototype-parity/contact-sheet-mobile.png
screenshots/prototype-parity/diffs/

# --- added by pre-wipe sweep ---
.env
.env.*
!.env.example
node_modules/
__pycache__/
.venv/
venv/
dist/
.hermes/
